# Destination DB (joinrs-intelligence / lw)
DATABASE_URL=mysql+pymysql://USER:PASS@HOST:3306/lw

# Source DB (mysql-production01 — job_postings + employers catalogs)
JOB_FEED_SOURCE_DATABASE_URL=mysql+pymysql://USER:PASS@mysql-production01...:3306/job_postings
JOB_FEED_DB_JOB_POSTINGS=job_postings
JOB_FEED_DB_EMPLOYERS=employers

# Slack Incoming Webhook (pipeline report + health alerts; optional locally)
SLACK_WEBHOOK_URL=
FEED_PUBLIC_BASE_URL=https://lw.joinrs.com
# Max age (hours) for X-Feed-Generated-At on gzip campaign feeds (health Cron)
FEED_STALE_HOURS=24
# Set to 0 to also Slack on all-OK health checks (default: quiet success)
# FEED_HEALTH_QUIET=1
